{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "General Panel — Varyant Girdi Şeması",
  "description": "TEKNOFEST 2026 General Panel (1500 Patojenik + 1500 Benign eğitim)",
  "type": "object",
  "properties": {
    "Variant_ID": {"type": "string", "description": "Anonim varyant kimliği"},
    "Ref_Nucleotide": {"type": "number", "description": "Referans nükleotid (kodlanmış)"},
    "Alt_Nucleotide": {"type": "number", "description": "Alternatif nükleotid (kodlanmış)"},
    "Codon_Change_Type": {"type": "number"},
    "AA_Grantham_Score": {"type": ["number", "null"]},
    "GC_Content_Window": {"type": "number", "minimum": 0, "maximum": 1},
    "In_CpG_Site": {"type": "number", "enum": [0, 1]},
    "Motif_Disruption_Score": {"type": "number"},
    "AA_Polarity_Change": {"type": ["number", "null"]},
    "AA_Hydrophobicity_Diff": {"type": ["number", "null"]},
    "AA_Mol_Weight_Diff": {"type": ["number", "null"]},
    "AA_Size_Diff": {"type": ["number", "null"]},
    "Protein_Impact_Score": {"type": "number"},
    "Delta_Solvent_Accessibility": {"type": ["number", "null"]},
    "Secondary_Structure_Disruption": {"type": "number", "enum": [0, 1]},
    "GERP_RS": {"type": ["number", "null"]},
    "PhyloP100way_vertebrate": {"type": ["number", "null"]},
    "phastCons100way_vertebrate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "SiPhy_29way_logOdds": {"type": ["number", "null"]},
    "Phylo_Diversity_Index": {"type": ["number", "null"]},
    "gnomAD_exomes_AF": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "gnomAD_exomes_AF_afr": {"type": ["number", "null"]},
    "gnomAD_exomes_AF_eur": {"type": ["number", "null"]},
    "gnomAD_exomes_AF_eas": {"type": ["number", "null"]},
    "gnomAD_exomes_AF_sas": {"type": ["number", "null"]},
    "gnomAD_exomes_AF_amr": {"type": ["number", "null"]},
    "ExAC_AF": {"type": ["number", "null"]},
    "SIFT_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "PolyPhen2_HDIV_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "PolyPhen2_HVAR_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "CADD_phred": {"type": ["number", "null"]},
    "REVEL_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "MutPred2_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "VEST4_score": {"type": ["number", "null"]},
    "PROVEAN_score": {"type": ["number", "null"]},
    "MutationTaster_score": {"type": ["number", "null"]},
    "MetaSVM_score": {"type": ["number", "null"]},
    "MetaLR_score": {"type": ["number", "null"]},
    "MCAP_score": {"type": ["number", "null"]},
    "In_Critical_Protein_Domain": {"type": "number", "enum": [0, 1]},
    "Splice_Site_Distance": {"type": ["number", "null"]},
    "Is_Exonic": {"type": "number", "enum": [0, 1]},
    "Exon_Conservation_Ratio": {"type": ["number", "null"]},
    "OMIM_Disease_Gene": {"type": "number", "enum": [0, 1]},
    "Label": {"type": "string", "enum": ["Pathogenic", "Benign", "Likely Pathogenic", "Likely Benign"]},
    "Panel": {"type": "string", "const": "General"},
    "Nuc_Context": {"type": ["string", "null"]},
    "AA_Context": {"type": ["string", "null"]}
  },
  "required": ["Variant_ID", "Label"],
  "additionalProperties": false,
  "x-panel-info": {
    "name": "General",
    "train_pathogenic": 1500,
    "train_benign": 1500,
    "test_pathogenic": 375,
    "test_benign": 375,
    "class_ratio": "1:1"
  }
}
